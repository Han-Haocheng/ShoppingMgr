# ShoppingMgr 环境变量示例（复制为 .env 后按需修改）
#   cp .env.example .env
# 说明：.env 已被 .gitignore 忽略，不要提交；flask CLI（如 flask --app run:app ...）与
# python run.py 都会读取项目根目录的 .env；也可用环境变量覆盖（环境变量优先于 .env）。

# 会话签名密钥：生产必填。留空等于未设置；不设置且未开启调试时 create_app() 会直接报错。
# 生成一个随机值：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# 数据库连接串：可选。默认 sqlite:///shop.db，即项目根下的 instance/shop.db。
DATABASE_URL=sqlite:///shop.db

# 监听地址：可选。默认 127.0.0.1；只在本机使用时不要改成 0.0.0.0。
HOST=127.0.0.1

# 监听端口：可选。默认 5000。
PORT=5000

# 调试开关：可选。默认关闭；只有 1/true/yes（忽略大小写）才算开启。
# 开启时允许缺少 SECRET_KEY 并自动使用固定开发密钥（会打警告）；生产环境必须保持关闭。
FLASK_DEBUG=0
